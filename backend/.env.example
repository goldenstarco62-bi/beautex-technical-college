# Server Configuration
PORT=5000
NODE_ENV=production

# JWT signing secret — use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret_here

# Database Configuration (leave empty to use local SQLite)
MONGODB_URI=
DATABASE_URL=

# Email Configuration (SMTP) — Gmail requires an App Password
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMS Configuration (Africa's Talking)
AT_USERNAME=sandbox
AT_API_KEY=
SMS_SENDER_ID=BEAUTEX

# M-Pesa Daraja API Configuration
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Shared secret for the STK callback webhook (long random value). REQUIRED in
# production. Configure the Safaricom CallbackURL as:
#   https://<host>/api/finance/mpesa-callback?token=<MPESA_CALLBACK_TOKEN>
MPESA_CALLBACK_TOKEN=
MPESA_CALLBACK_URL=https://your-domain.com/api/finance/mpesa-callback

# Seed script (backend `npm run seed`)
# Email for the initial superadmin. If SEED_ADMIN_PASSWORD is empty, a random
# password is generated and printed to the console once. Password change is forced.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Links Configuration — used for login links in Welcome Emails
FRONTEND_URL=https://your-frontend-app.vercel.app
